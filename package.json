{
  "name": "distributed-wagering-processor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun run src/main/main.ts",
    "start:outbox-publisher": "bun run src/main/outbox-publisher.ts",
    "start:reference-worker": "bun run src/main/reference-worker.ts",
    "start:consumer": "bun run src/main/consumer.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "db:migrate": "bun run src/main/migrate.ts up",
    "db:rollback": "bun run src/main/migrate.ts down",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "3.1165.0",
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@mikro-orm/core": "7.2.8",
    "@mikro-orm/migrations": "7.2.8",
    "@mikro-orm/postgresql": "7.2.8",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}

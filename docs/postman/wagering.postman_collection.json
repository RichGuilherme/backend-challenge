                  "const body = pm.response.json();",
                  "pm.test(\"error WALLET_ALREADY_EXISTS\", () => pm.expect(body.error).to.eql(\"WALLET_ALREADY_EXISTS\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": { \"amount\": \"1000.00\", \"currency\": \"BRL\" }\n}",
              "options": {

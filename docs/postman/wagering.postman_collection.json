        {
          "name": "REFUND vira PROCESSED pelo worker",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const url = pm.variables.replaceIn(\"{{baseUrl}}/providers/{{providerId}}/wagering/transactions/{{runId}}-refund-late\");",
                  "const token = pm.collectionVariables.get(\"accessToken\");",
                  "let attempts = 0;",
                  "const poll = () => {",
                  "  pm.sendRequest({ url, method: \"GET\", header: { Authorization: \"Bearer \" + token } }, (error, response) => {",
                  "    attempts += 1;",
                  "    const pending = error || response.code !== 200 || response.json().status === \"PENDING_REFERENCE\";",
                  "    if (pending && attempts < 30) setTimeout(poll, 1000);",
                  "  });",
                  "};",
                  "poll();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",

            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/providers/{{providerId}}/wagering/transactions/{{runId}}-refund-late",
            "description": "O pre-request espera até 30s pelo reference-worker (consulta a cada 1s). Se falhar, confira `docker compose ps reference-worker`."
          }
        }

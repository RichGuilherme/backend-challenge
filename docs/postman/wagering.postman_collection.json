              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/health/live",
            "description": "Liveness: o processo está vivo."
          }
        },
        {
          "name": "GET /health/ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"postgres e sqs up\", () => pm.expect(JSON.stringify(body)).to.include(\"up\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/health/ready",
            "description": "Readiness: PostgreSQL e SQS alcançáveis. Para ver 503, rode `docker compose stop postgres`."
          }
        }
      ]
    },
    {
      "name": "1. Wallets",
      "description": "README §9 (Criar wallet e consultas).",
      "item": [
        {
          "name": "Criar wallet com saldo inicial 1000.00",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString(36) + Math.random().toString(36).slice(2, 6));",
                  "pm.collectionVariables.set(\"playerId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"saldo 1000.00 e version 1\", () => {",
                  "  pm.expect(body.balance).to.eql({ amount: \"1000.00\", currency: \"BRL\" });",
                  "  pm.expect(body.version).to.eql(1);",
                  "});",
                  "pm.collectionVariables.set(\"walletId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": { \"amount\": \"1000.00\", \"currency\": \"BRL\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/wallets",
            "description": "Gera OPENING + CREDIT na mesma transação SQL. Cria um playerId e um runId novos, e guarda o walletId para os próximos requests."
          }
        },
        {
          "name": "Criar wallet duplicada → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
